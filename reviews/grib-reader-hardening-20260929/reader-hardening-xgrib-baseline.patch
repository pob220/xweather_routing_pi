+  std::unique_ptr<GribRecord> owner(rec);
+  if (!rec) return false;
+  // Conservative metadata allowance also bounds files containing millions of
+  // tiny constant fields. This is a retained-record budget, not a RAM probe.
+  std::size_t count;
