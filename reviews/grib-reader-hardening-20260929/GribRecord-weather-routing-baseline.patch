+    result->La2 = La2;
+    result->Lo1 = Lo1;
+    result->Lo2 = Lo2;
+    result->latMin = std::min(La1, La2);
+    result->latMax = std::max(La1, La2);
+    result->lonMin = Lo1;
+    result->lonMax = Lo2;
+    result->BMSsize = 0;
+    result->hasBMS = false;
+    result->BMSbits = nullptr;
