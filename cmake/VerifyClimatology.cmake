file(READ "${CMAKE_CURRENT_SOURCE_DIR}/data/climatology/dataset-manifest.json" _climate)
string(JSON _version GET "${_climate}" dataset_version)
if(NOT _version STREQUAL "ocpn-climatology-2026.2")
  message(FATAL_ERROR "Unexpected bundled Climatology dataset: ${_version}")
endif()
string(JSON _count LENGTH "${_climate}" outputs)
math(EXPR _last "${_count}-1")
foreach(_index RANGE 0 ${_last})
  string(JSON _file GET "${_climate}" outputs ${_index} file)
  string(JSON _hash GET "${_climate}" outputs ${_index} sha256)
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/data/climatology/${_file}" _actual)
  if(NOT _actual STREQUAL _hash)
    message(FATAL_ERROR "Climatology data missing or corrupt: ${_file}")
  endif()
endforeach()
unset(_climate)
